 # read only access :
If user require only read only access use below command to provide access.

GRANT SELECT ON database_name.table_name TO 'username'@'localhost' IDENTIFIED BY 'password';

   # read / write : 
If user want tA	o write some changes in database user require update & insert access.

GRANT SELECT,INSERT,PROCESS,UPDATE ON database_name.table_name TO 'username'@'localhost' IDENTIFIED BY 'password';

   # read / write / delete :
If user want read, write & delete access of table use below command.

GRANT SELECT,INSERT,UPDATE,PROCESS,DELETE ON database_name.table_name TO 'username'@'localhost' IDENTIFIED BY 'password';

   # read / write / delete / execute :
If user want access to execute existing SP use below command.

GRANT SELECT,INSERT,UPDATE,DELETE,PROCESS,EXECUTE ON database_name.table_name TO 'username'@'localhost' IDENTIFIED BY 'password';

Note : In above case user can only execute sp. To check / read SP you need to give access of mysql.proc table Or you must have the ALTER ROUTINE privilege for that particular procedure.

GRANT SELECT ON mysql.proc TO 'username'@'IP' IDENTIFIED BY 'password';

  # Delete SP :
You must require ALTER ROUTINE privileges for that particular procedure.

GRANT ALTER ROUTINE ON databasename.spname TO 'username'@'localhost' IDENTIFIED BY 'password';

  # Infile Outfile Access :
You can not provide infile / outfile access for single database.

  Grant file on *.* TO 'Username'@'IP' IDENTIFIED BY 'PASSWORD';flush privileges;

 # Grant all access :
GRANT CREATE,DROP,LOCK TABLES,REFERENCES,EVENT,ALTER,DELETE,INDEX,INSERT,SELECT,UPDATE,CREATE TEMPORARY TABLES,TRIGGER,CREATE VIEW,SHOW VIEW,ALTER ROUTINE,PROCESS,CREATE ROUTINE,EXECUTE ON Database_name.* TO 'Username'@'IP' IDENTIFIED BY 'PASSWORD';flush privileges;



