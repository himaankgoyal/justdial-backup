#!/bin/bash

DATE=$(date +%d-%m-%Y)
LOCK_FILE="/tmp/git_build_quick_services_staging.lock"

TMP_DIR="/var/www/production/tmp/quickquotes_backend_staging/"
PROD_DIR="/var/www/production/quickquotes_backend_staging/"

line() {
   echo -e "\n---------------------------------------\n"
}

bigline() {
   echo -e "\n===============================================================================\n"
}

logfile () {
   sudo tee -a /var/log/daily_log/git_build_quick_services_staging_${DATE}.txt
}

if [ -e ${LOCK_FILE} ]; then echo "Git Update for git_build_quick_services_staging is already in progress... Exiting"; exit 1; else echo "Creating lock file ${LOCK_FILE}"; touch ${LOCK_FILE}; fi

bigline | logfile ; echo -e "Git update process at `date`" | logfile; line | logfile

echo -e "Git info before update\n---------------------------" | logfile
cd ${TMP_DIR} && sudo git log | head | logfile
line  | logfile

echo -e "Updating code\n-----------------------" | logfile
cd ${TMP_DIR} && sudo git pull | logfile
line | logfile

echo -e "Git info after code update\n--------------------" | logfile
cd ${TMP_DIR} && sudo git log | head | logfile
line | logfile

echo -e "\n-------------- Syncing code... \n-----------------" | logfile

sudo rsync -arvpP --exclude '.git' --exclude '.svn' --exclude 'ServerSet.txt' --exclude 'LoadBalancer_HealthCheck.php' ${TMP_DIR} ${PROD_DIR} | logfile

sudo chown -R apache:apache ${PROD_DIR} | logfile

bigline | logfile

echo "Removing Lock file"
sudo rm -rfv $LOCK_FILE




