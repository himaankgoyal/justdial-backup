# Mysql tweaks by ranjeet
# The following options will be passed to all MySQL clients
[client]
#password	= your_password
port		= 3306
socket		= /var/lib/SQL/mysql/mysql.sock
#default-character-set=utf8	#comment set as per mysql8

# Here follows entries for some specific programs
# The MySQL server
################################################################################################
[mysqld] 						#set as per mysql8 
#mysqld = /usr/bin/mysqld_safe 				#set as per mysql8 
#mysqladmin = /usr/bin/mysqladmin 			#set as per mysql8 


[mysqld]
port            = 3306
user            = mysql 				#set as per mysql8 
socket          = /var/lib/SQL/mysql/mysql.sock
datadir         = /var/lib/SQL/mysql
#datadir         = /BACKUP_TESTING/extrated_bkp/datadir
tmpdir = /var/lib/SQL/mysql_tmpdir
slave_load_tmpdir = /var/lib/SQL/mysql_tmpdir

#skip-locking
federated
#table_cache=6000
binlog_format   = STATEMENT
##Slave setup block
server-id=17133
report-host=192.168.17.133
log_bin_trust_function_creators=TRUE
expire_logs_days=5
max_binlog_size=1024M

#########################################
##log-bin=/var/lib/SQL/binary_log/mysql-bin.log			#comment set as per mysql8 its slave
relay-log=/var/lib/SQL/binary/relay-bin 			
###########################################
innodb_ft_result_cache_limit=4294967295
innodb_ft_total_cache_size=1600000000
sync_binlog=1
log-error=/var/lib/SQL/mysqld.log
default-storage-engine = MyISAM
#replicate_wild_ignore_table=mysql.user
#early-plugin-load=keyring_okv.so  				#Oracle_Key_Vault
#keyring_okv_conf_dir=/var/lib/oracle/okvutil			#Oracle_Key_Vault


#####GTID#####
#gtid_mode=ON							#comment set as per mysql8
#enforce-gtid-consistency					#comment set as per mysql8

#master_info_repository=TABLE					#comment set as per mysql8
#relay_log_info_repository=TABLE				#comment set as per mysql8
#log-slave-updates=ON						#comment set as per mysql8
##############


# Added on 24/06/2016  - On recommendation of SOC team
#secure_auth=ON 							#comment set as per mysql8
# sql-mode="NO_AUTO_CREATE_USER"
sql-mode="ERROR_FOR_DIVISION_BY_ZERO ,IGNORE_SPACE ,ALLOW_INVALID_DATES" #set as per mysql8  
#End of Slave setup block
#
#Innodb section
## You can write your other MySQL server options here
## ...
##innodb_force_recovery=4
innodb_data_home_dir =
##
## Data files must be able to hold your data and indexes
innodb_data_file_path=ibdata1:2800M;ibdata2:2800M:autoextend
##
## Set buffer pool size to 50-80% of your computer's memory,
## but make sure on Linux x86 total memory usage is < 2GB
##innodb_buffer_pool_size=8G
innodb_buffer_pool_size=16G #Shantanu
innodb_ft_cache_size=16000000
##innodb_additional_mem_pool_size=500M
#innodb_additional_mem_pool_size=1M #Shantanu #comment set as per mysql8 
##innodb_log_group_home_dir=
##
innodb_log_files_in_group=2
# Set the log file size to about 25% of the buffer pool size
innodb_log_file_size=1G
##innodb_log_buffer_size=50M
innodb_log_buffer_size=8M #Shantanu
##
innodb_flush_log_at_trx_commit=1
innodb_lock_wait_timeout=50
##
## Uncomment the next lines if you want to use them
##innodb_thread_concurrency=5
innodb_file_per_table
open_files_limit = 15000
#
##End of Innodb section
#

#skip-log-bin 						#set as per mysql8 its slave skipping binary logging

default_authentication_plugin=mysql_native_password 	#set as per mysql8 
character-set-server=utf8       			#set as per mysql8 
collation-server = utf8_unicode_ci      		#set as per mysql8 
character-set-filesystem=binary         		#set as per mysql8 
secure-file-priv = "" 					#set as per mysql8 

#log=/var/log/mysql/mysqld.log
slow_query_log=1
long_query_time=2
#log_slow_queries=/var/log/mysql/mysql-slow.log
#log_slow_queries=/var/lib/webport_SQL/slow-queries-webport.log
slow_query_log_file=/var/lib/SQL/mysql-slow.log

#stop name resolv
skip-name-resolve

max_connections = 2400
max_user_connections = 2400
max_connect_errors=50

wait_timeout=600
connect_timeout=5
interactive_timeout=120

join_buffer_size=1M
#read_buffer_size=4M
read_buffer_size=16M #As proposed by shantanu
#read_rnd_buffer_size=16M
read_rnd_buffer_size= 141557760 #As proposed by Shantanu

#table_cache=4096
max_allowed_packet=64M

#key_buffer is depcrecated - Mitul <mitul@enterux.com>
#key_buffer=1024M
key_buffer_size=40G
#key_buffer_size=2096M #As proposed by shantanu

myisam_max_sort_file_size = 20G

sort_buffer_size = 2M
myisam_sort_buffer_size = 32M

#myisam_sort_buffer_size = 8M #As proposed by shantanu

thread_cache_size=1600

#to allow simultaneous insert when myisam has obtained Exclusive lock
concurrent_insert=2

#query_cache_limit=8M #To disable query cache as proposed by shantanu 		#comment set as per mysql8
#query_cache_min_res_unit=1 #To disable query cache as proposed by shantanu
#query_cache_size=512M #Changed by Keyur on 3rd Jan 2013 			#comment set as per mysql8
#query_cache_type=1 #To disable query cache as proposed by shantanu		#comment set as per mysql8
#skip-bdb
#skip-innodb
group_concat_max_len = 500000
ft_min_word_len = 2
ft_stopword_file = /etc/stopword.txt
##skip-slave-start
#New Setting proposed by shantanu
max_heap_table_size=1000000000
tmp_table_size = 1000000000


[mysqldump]
quick
max_allowed_packet = 16M

[myisamchk]
key_buffer = 256M
sort_buffer_size = 256M
read_buffer = 2M
write_buffer = 2M

[mysqlhotcopy]
interactive-timeout

